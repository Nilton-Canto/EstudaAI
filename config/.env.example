# ==============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# ==============================================================================

# Chave secreta do Django (gere uma nova para produção!)
# Para gerar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua_secret_key_aqui

# Debug (True para desenvolvimento, False para produção)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# INTEGRAÇÃO COM GEMINI AI
# ==============================================================================

# Chave da API do Google Gemini
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo do Gemini a ser usado
GEMINI_MODEL=gemini-2.0-flash

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================

# Permitir todas as origens (True apenas em desenvolvimento!)
CORS_ALLOW_ALL_ORIGINS=True

# Origens permitidas (se CORS_ALLOW_ALL_ORIGINS=False)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
